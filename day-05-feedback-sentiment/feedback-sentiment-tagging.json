            "mapper": {
                "model": "gpt-5-nano",
                "textPrompt": "You classify customer feedback. Reply with a single JSON object and nothing else: no explanation and no markdown formatting.\n\nService: {{1.`3`}}\nRating (1-5): {{1.`4`}}\nComment: {{1.`5`}}\n\nReturn JSON with exactly these keys:\r\n\"sentiment\": one of \"positive\", \"negative\", \"mixed\", \"neutral\"\r\n\"category\": one of \"Onboarding\", \"Support\", \"Billing\", \"Product\", \"Other\"\r\n\"summary\": a plain-English summary of 15 words or fewer\r\n\"needs_followup\": \"yes\" only if the customer is upset, at risk of leaving, or reported a problem that blocks them or costs them money, otherwise \"no\"\r\nJudge sentiment from the whole comment, including sarcasm, not just the rating."
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "setupValidation": {
                    "version": 1,
                    "configuration": "daac3b7c039fa7f7",
                    "result": {
                        "valid": true,
                        "fields": []
                    }
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "GPT-5 nanoThe most cost-effective option for casual conversation and straightforward, simple fact-retrieval"
                        }
                    }
                },
                "expect": [
