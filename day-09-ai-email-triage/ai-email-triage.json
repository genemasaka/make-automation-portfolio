        {
            "id": 2,
            "module": "openai-gpt-3:askAnything",
            "version": 1,
            "parameters": {},
            "mapper": {
                "model": "gpt-5-nano",
                "textPrompt": "You triage incoming business email. Reply with a single JSON object and nothing else: no explanation and no markdown formatting.\n\nFrom: {{1.fromName}}\nSubject: {{1.subject}}\nEmail body: {{1.fullTextBody}}\n\nReturn JSON with exactly these keys:\r\n\"category\": one of \"Sales inquiry\", \"Support issue\", \"Meeting request\", \"General question\", \"Spam\"\r\n\"urgency\": one of \"high\", \"medium\", \"low\"\r\n\"summary\": a plain-English summary of 15 words or fewer\r\n\"draft_reply\": a short, polite, professional reply of 60 words or fewer, signed \"The Team\"\r\n\r\nRules for the reply:\r\n- Never state a price, deadline, discount or promise. For pricing questions say we will send a tailored quote.\n- Never ask the customer for payment card details, passwords or ID numbers\n- For a meeting request, say we will confirm a time shortly. Do not accept a specific time.\r\n- For an upset customer, acknowledge the problem and say it is being looked into today.\r\n- For Spam, set \"draft_reply\" to an empty string.\r\n- Write line breaks inside \"draft_reply\" as \\n so the JSON stays valid.\r\nMark urgency \"high\" only for threats to leave or dispute payment, money problems, or time-critical requests."
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "b84b571fb83425fe"
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "GPT-5 nanoThe most cost-effective option for casual conversation and straightforward, simple fact-retrieval"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true,
                        "validate": {
                            "enum": [
                                "gpt-5-nano",
                                "gpt-6.1-sol",
                                "gpt-6-sol",
                                "gpt-6-luna",
                                "gpt-6-astra",
