            "version": 4,
            "parameters": {
                "__IMTCONN__": 11711304
            },
            "filter": {
                "name": "Skip spam",
                "conditions": [
                    [
                        {
                            "a": "{{3.category}}",
                            "b": "Spam",
                            "o": "text:notequal"
                        }
                    ]
                ]
            },
